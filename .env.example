# Karakeep MCP server: copy to .env, fill in, chmod 600. Every value also belongs in your password manager.

# Required: the address of your Karakeep, as this server reaches it (a LAN address is fine).
KARAKEEP_URL=https://karakeep.example.com

# Optional: Karakeep's public address, for the links in tool results, when KARAKEEP_URL is an internal one.
# KARAKEEP_PUBLIC_URL=https://karakeep.example.com

# OAuth login for claude.ai and the Claude apps. Both set: OAuth is on (header keys still work); either missing: header keys only.
# MCP_BASE_URL: this server's public address (https, no /mcp).
# MCP_BASE_URL=https://karakeep-mcp.example.com
# MCP_OAUTH_SECRET: encrypts the login store; at least 32 random characters (openssl rand -hex 32). Changing it signs everyone out.
# MCP_OAUTH_SECRET=

# Where the login store lives (default /data; mount it). Losing it only means signing in again.
# DATA_DIR=/data

# TLS checking towards Karakeep against the OS trust store (default true). false turns checking off.
# VERIFY_TLS=true

# Listen address and port (defaults 0.0.0.0 and 8000).
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# Optional: comma-separated Host names to accept (DNS-rebinding protection); empty accepts any Host.
# MCP_ALLOWED_HOSTS=
